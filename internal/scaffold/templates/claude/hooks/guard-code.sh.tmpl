#!/usr/bin/env bash
# PreToolUse guard for --mode learn. Denies Edit/Write/MultiEdit outside the
# docs allowlist (*.md, docs/**, .claude/**), per learn overlay (see
# .claude/rules/learn.md). Reads the hook's JSON payload from stdin.
#
# A negação usa `hookSpecificOutput.permissionDecision`, a forma que a doc do
# Claude Code manda usar em PreToolUse. O `{"decision":"block"}` de topo ainda
# é honrado (verificado em 2.1.220), mas é explicitamente desaconselhado — e
# este hook é o único bloqueio do modo learn, então não se apoia em forma
# tolerada. Em PostToolUse o `decision` de topo continua correto: é o que o
# guard-vocab usa, e não muda.
set -euo pipefail

# Falha fechado: sem jq o hook não consegue ler o payload e, portanto, não
# consegue decidir. Um hook que bloqueia nunca deve deixar passar por não
# saber — o guard-vocab pode fazer no-op porque só avisa, este não pode.
# `command` e `echo` são builtins, então esta checagem funciona sem PATH.
if ! command -v jq >/dev/null 2>&1; then
  echo '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"guard-code: modo learn precisa do jq para decidir e ele não está instalado; edição negada. Instale o jq e tente de novo (dnf install jq / apt install jq / brew install jq)."}}'
  exit 0
fi

payload="$(cat)"
file_path="$(jq -r '.tool_input.file_path // empty' <<<"$payload")"

if [[ -z "$file_path" ]]; then
  # No single file_path (e.g. some MultiEdit shapes) — fail closed.
  echo '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"guard-code: modo learn não conseguiu determinar o arquivo alvo; edição negada por segurança"}}'
  exit 0
fi

rel="${file_path#"$PWD"/}"

case "$rel" in
  *.md|docs/*|.claude/*)
    exit 0
    ;;
  *)
    # Montado com jq, não com aspas escapadas à mão: um caminho contendo `"` ou
    # `\` produziria JSON inválido, e JSON inválido num hook que nega significa
    # falhar aberto — o oposto do contrato deste arquivo.
    jq -n --arg rel "$rel" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: ("guard-code: modo learn não edita código diretamente (" + $rel + "). Explique o próximo passo em vez de escrever a solução.")}}'
    exit 0
    ;;
esac
